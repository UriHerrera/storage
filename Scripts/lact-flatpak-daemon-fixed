#!/usr/bin/env bash

# SPDX-License-Identifier: BSD-3-Clause
# Copyright 2023-2025 <Nitrux Latinoamericana S.C. <hello@nxos.org>>


# -- Exit on errors.

set -e


# -- Resolve the absolute path of the directory containing this script.

SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
FLATBOX_BIN="${SCRIPT_DIR}/flatbox"


# -- Navigate up 7 levels to reach the flatpak root from .../files/bin.
# -- Using realpath with relative navigation is cleaner than multiple dirname calls.

FLATPAK_USER_DIR=$(realpath "$SCRIPT_DIR/../../../../../../..")

export LACT_DAEMON_SOCKET_PATH="/run/host/root/run/lactd.sock"
export LACT_DAEMON_CONFIG_DIR="/run/host/root/etc/lact"

if [[ -S "$LACT_DAEMON_SOCKET_PATH" ]]; then
    if ! command -v ss >/dev/null 2>&1; then
        echo "Cannot determine whether $LACT_DAEMON_SOCKET_PATH is in use: ss is unavailable." >&2
        exit 1
    fi

    if ss -xl 2>/dev/null | grep -Fq -- "$LACT_DAEMON_SOCKET_PATH"; then
        echo "LACT daemon is already listening on $LACT_DAEMON_SOCKET_PATH."
        exit 0
    fi

    rm -f -- "$LACT_DAEMON_SOCKET_PATH"
fi

exec "$FLATBOX_BIN" run \
    --flatpak-install-path "$FLATPAK_USER_DIR" \
    --app io.github.ilya_zlobintsev.LACT \
    --apparmor-unconfined \
    lact daemon
